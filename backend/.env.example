# Copy to .env for local development. Never commit .env.
ENV=local                    # local | staging | prod (dev auth, memory and mocks are refused in prod)

# Adapters (local defaults need no cloud credentials)
DATA_BACKEND=memory          # memory | firestore
AUTH_MODE=dev                # dev | firebase  (dev is refused when ENV=prod)
MOCK_INFERENCE=true
MOCK_QUALITY=true            # set false once the real quality check (B4) is done
MOCK_SCENARIO=cycle          # normal | needs_checkup | unclear | cycle
LOCAL_DATA_DIR=local_data    # where audio goes when DATA_BACKEND=memory

# Google Cloud / Firebase
GCP_PROJECT=heartscreen-abc
STORAGE_BUCKET=heartscreen-abc-data
# Local cloud access: gcloud auth application-default login (no key file)

# Gemini on Vertex AI (no API key)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=heartscreen-abc
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_S=15

# Model (version, threshold and sample rate come from models/model_meta.json)
MODEL_PATH=./models/model.onnx
FFMPEG_PATH=ffmpeg           # full path if ffmpeg is not on PATH
# FUSION_PATH=./models/fusion.json   # off for MVP

# HTTP
CORS_ORIGINS=*

